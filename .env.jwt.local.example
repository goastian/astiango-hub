# Copy this file to .env.jwt.local only for local development. Do not commit it.
# Inject the actual keyset from Docker/Kubernetes secrets or your secret manager.
ASTIANGO_JWT_KEYSET='{"active_kid":"2026-09","keys":{"2026-09":"<base64-secret-of-at-least-32-bytes>"}}'
# Set these from your secret manager; do not commit their values.
ASTIANGO_AUTH_KEY='<unique-shared-auth-secret-at-least-32-bytes>'
ASTIANGO_ENCRYPTION_KEYSET='{"active_kid":"2026-09","keys":{"2026-09":"<base64-secret-of-exactly-32-bytes>"}}'
# Required only while creating the first root administrator. Remove afterwards.
ASTIANGO_BOOTSTRAP_ADMIN_USERNAME='<unique-bootstrap-admin-username>'
ASTIANGO_BOOTSTRAP_ADMIN_PASSWORD='<unique-bootstrap-admin-password-at-least-12-characters>'
